PORT=3003
NODE_ENV=development
SERVICE_NAME=inventory-service
DATABASE_URL=
DIRECT_URL=

AUTH_JWKS_URL=http://auth-service:3002/.well-known/jwks.json
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=food-wise-api
AUTH_ACCESS_TOKEN_COOKIE_NAME=fw_access
# Optional local fallback for development/tests. Prefer AUTH_JWKS_URL in Kubernetes.
AUTH_JWT_PUBLIC_KEY_PEM=

# Legacy internal gateway tokens. Keep only if a service-to-service route still uses InternalServiceGuard.
# ALLOWED_GATEWAY_TOKEN_CURRENT=
# ALLOWED_GATEWAY_TOKEN_PREVIOUS=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_INVENTORY_PHOTOS_BUCKET=inventory-item-photos

# Gateway configuration examples:
# Local development outside Docker:
# INVENTORY_SERVICE_URL=http://localhost:3003
#
# Docker Compose:
# INVENTORY_SERVICE_URL=http://inventory-service:3003
